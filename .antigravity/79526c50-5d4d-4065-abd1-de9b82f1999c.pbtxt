    content: "        Column(\n            modifier = Modifier\n                .fillMaxWidth()\n                .weight(1f)\n                .verticalScroll(rememberScrollState())\n        ) {\n            // Hero Card matching user\'s photo with MRI scanner photo background\n            HeroProgressCard(\n                completedCount = state.completedCount,\n                totalCount = state.totalNodesCount,\n                lastVisitedTitle = if (state.isResumeRestored) state.lastVisitedNode.title else \"Memuat posisi terakhir\342\200\246\",\n                userAvatarId = state.userAvatarId,\n                userName = state.userName,\n                onOpenCharacterRoom = { viewModel.selectTab(MainTab.KARAKTER) },\n                onContinueClicked = { viewModel.resumeStudy() }\n            )\n\n            Spacer(modifier = Modifier.height(24.dp))\n\n            // Section Title: \"Simulasi interaktif\"\n            Text("
