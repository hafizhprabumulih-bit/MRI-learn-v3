            }
            lines {
              text: "                .clip(RoundedCornerShape(2.dp)),"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            color = if (progress > 0.3f) CyanBright else Color(0xFF475569),"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
