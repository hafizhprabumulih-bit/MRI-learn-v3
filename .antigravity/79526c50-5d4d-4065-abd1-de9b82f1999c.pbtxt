              text: "        ) {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            Text(text = label, fontSize = 9.sp, fontWeight = FontWeight.Bold, color = TextSecondary)"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
