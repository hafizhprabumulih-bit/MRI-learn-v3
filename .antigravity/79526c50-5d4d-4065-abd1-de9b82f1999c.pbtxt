      thinking_signature: "\022\254\022\n\251\022\001i\024}\023\212\253\210\210#A9\003Rw\363\376J\266\036\'\332\330_m=0\316\033\272k\373\322\211\274\375\304\317x\237\344\250i$g\323\202\353\021\341\354\276\021Ft\330/\201n\233\350\341\306\016s\030+\000\344D)=h\220\001\234\270\t\274f-t\346\002\230\'\311\016\177M=\321Xa#\203z&\363\210\234\365\207oBX\345\355\233\330\315\261\257@\321uk\227L\207\374\366\004|~\266\250\026\202\320t\320S\262\'\304\235\ag\257\215\223\345pg\325~\232=>G\364\201lV\337\217\307\236a34\360\3410\233\b\333\336\215\272\320\240\256so\020\351\334\357\216\266t\307M\251\332\346!K Y\030#\266\304#-\r\263\310\275o\345\247CKw\024u\002{|\223;\201=o\214]\255!L\005\205\f\032\211Q\367\v\377{l\351Z?%\031\2745\322+N\'\325\201\r\200\221\220\371\345\302\023r\221\301G\377V\250\210 \227x\362\033(\200\364S@N\247+\202\200\265O\266\005X\3208\352\266\343L\031\265e\347\224t\224E\021aC\257L]\241(\373\241\330\225G\326\207\024\247k\0261\245M\rqFA\254~\017\v\017\356\237\237\273\016\334\202\343/\342|E\261u\237\004\305fq\027tS\341\313\324\361\017;\034\025\242\217\006\003Z\343\031\027v&4\260.Y\231U\202\335\332{N\264K\301q\261\205\025d\362Nt\0355A5\270BE\341\256\347\221\230X}\367o\344\346\360\001\3525\227\271(\026?\243E7\360\nWI\300\326\tl\305p@\301\2532\211\312>\270\177\201\036\355\004|@z\v\260i\250\021\360\n\372)\273R\254\347L\3266\031v\270\244\351\317\257%\206\315\256\t*w\363\374\005~\343a\256S\255\231\334\235u\313M=O\210\024\344\273\212\366CFE\032\377$\236\356\201\2207$Hc#z\033\234A\315]\317\0267kYq\241\352\231\032\332\365[V\237\376\021\230(\261m.\375\340\267F\"TG\262\364#i\a\271w\027M\301\370\277\345\250i.z\257F,Z\265v\335\216\254N\206\234\r\227\021\037\227=\02404\316c\347\220\233\233\255\210\361?\206\327!%\245\001\211Q\372\006\363]\212\345\304\303\\\b\023\247\355e\345R\216\3561s\003\021\202%\246]&\f^\215\036L\323\245]T~\334\363Q\021\253c/\035o3\334/a\353\330_\312\277\202\260 k1i\313\031$\337\227\035\265\207\254\fdTa\3548\350\235\234\225\230\313\305\017\244\203\034\357\023K$T\376\212\253\220\342\024\265\256\003\363yJkw\262\273\373\344\350\277p\231k\230\215-n\035\271#&J\263\346\271\330\210\250\021`` \227\020\264\251\355\277\271\334\217\311^(2\212|g\305F\324\204KX\3437?\353\305\353Cu\nB\201\312\236\243IX5\237\234F\365\202\036\025~@{\210\271\3569TQ\363@\307\221\302\366A\021\327\354}\243\320Zm\\\262xjn1\f\0364xt*\n\342\201\325l\335HL[\026\212)\'Mx\266\264{\033\ae\227\316Q\254\346T4\363\221\000\257\030\311f\023A\234y\253\000\313\363u\002\271\005\362Q\276E\037\234x\353\300=\207\314-^\241\322\230\343\333~\220\327B\003/p\262>%sW\357\0162\205y\355\210\307\024\030\245\242]\353\374\2517\313*H77@\001\bn+Q,\0375UR_r14G\310^\201\317\212\261\235\367\2640\201L6\347\025\277)\254\024x=\274\242\254\247\347\310\377\000\265/&x\367\340i&{y+\270fb\357\3534l\037\320\246\237\2451\003\223\343\031-\214\244\372\\\234\221\357\277\354\371G\0032\335z\023\322r\272\340H\202\340\211]\371\375\251ZP\257\304\246\341C\331\321@\263\353\251\322L\247odu\375`\006\356\230Z\034\203\031g\327\034\275\023\317\373@ DX\006y\225~!\313;S\362\347||Hy4\243Y6Nei\234\260\025tzYo\032\375QR\340\234\313\304i\023\317\215A\275V\322\016 \315\fB\243i\233\360\016\rJx\361\206\216r\351KKrJ\004\245B\274@\234\270g\212@\036v$\006\024\316b\261w\315\225\351\351a\v\036\n%Sv}\271\362}jl\323\b\003R\246\321\247\001\302j\033^P\342\374<EoQ\f2\035L0\257\035\232\301\336s\003w\352\227dU`TD\034\273\271\323\302\0202:@\r\332\367\033\243K\204\353\223\315\336\377\253\374\345\241sr\236Io\360\037e\n\205\231\034\303VUm\234\365\035\302-\034LI\177}+T\260\242\344x\037\352\251t\334d_)\372\304K7\266w\336\341Uv\233\006\315\265\256\033\335\347\356\277\377\336k\307@\024\232\370\254\362\242\311\276G$\356\211\251#PiL\3151\327l\254mjvg\000n:\0014=\334`\202\030c\337G^\242\036\203r\035-}\214\27510\301\370a\351w\366Ks\205\367\223\000\306r\'\373h37\241\270\375\177\235\231\244\tc\320\034\3324ok\201\205\203+\364\2537\344\201\271SB)quP\b#\215\001\215[\340\235\306\006h\003\273\214\254\321\017%\370\01749g2\314\2605zg\344\252\177ArX\240\254\345