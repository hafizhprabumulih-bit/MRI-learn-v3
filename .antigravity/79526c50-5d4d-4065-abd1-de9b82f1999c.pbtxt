              text: "fun ScanProgressBar(label: String, progress: Float) {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    Column(modifier = Modifier.fillMaxWidth()) {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        Row("
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            modifier = Modifier.fillMaxWidth(),"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            horizontalArrangement = Arrangement.SpaceBetween"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
