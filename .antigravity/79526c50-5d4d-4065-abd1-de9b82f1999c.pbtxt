    content: "\nenum class MainTab {\n    BERANDA,\n    ANIMASI,\n    SIMULASI,\n    TERSIMPAN,\n    CATATAN,\n    GLOSARIUM,\n    KUIS\n}\n\nenum class SimType {\n    SPIN_LARMOR,\n    KONTRAS_TR_TE,\n    RUANG_K,\n    SAR_SAFETY,\n    SCAN_TIME_ESTIMATOR,\n    PROTOKOL_TA_SNR,\n    KONSOL_VENDOR,\n    PESAWAT_MAGNET_M05,\n    GRADIEN_RF_M06,\n    SEKUENS_KONTRAS_M03,\n    ARTEFAK_QA_M08\n}\n\ndata class MriUiState(\n    val currentTab: MainTab = MainTab.BERANDA,\n    val modulesList: List<MriModule> = MriRepository.modules,\n    val quizzesList: List<QuizQuestion> = MriRepository.quizzes,\n    val selectedModule: MriModule? = null,\n    val selectedSimType: SimType = SimType.SPIN_LARMOR,\n    val completedNodeCodes: Set<String> = emptySet(),\n    val lastVisitedNodeCode: String? = null,\n    val isResumeRestored: Boolean = false,\n    // Streak Hari Belajar \360\237\224\245\n    val studyStreakDays: Int = 0,\n    val showStreakDialog: Boolean = false,\n    // Avatar Pengguna \360\237\221\250\342\200\215\342\232\225\357\270\217\360\237\221\251\342\200\215\342\232\225\357\270\217\n    val userAvatarId: String = \"radiografer_mri\",\n    val userName: String = \"\",\n    val showAvatarDialog: Boolean = false,\n    // Catatan Belajar (Notes) \360\237\223\235"
    num_lines: 1316
    num_bytes: 50322
    line_range_bytes: 1115
  }
