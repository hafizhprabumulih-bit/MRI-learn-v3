    content: "                    modifier = Modifier\n                        .fillMaxWidth()\n                        .clickable(onClick = onContinueClicked),\n                    shape = RoundedCornerShape(16.dp),\n                    color = Color(0xF2F8FAFC) // Light cream background as in photo\n                ) {\n                    Row(\n                        modifier = Modifier\n                            .fillMaxWidth()\n                            .padding(horizontal = 14.dp, vertical = 9.dp),\n                        horizontalArrangement = Arrangement.SpaceBetween,\n                        verticalAlignment = Alignment.CenterVertically\n                    ) {\n                        Column {\n                            Text(\n                                text = \"Lanjutkan\",\n                                fontSize = 10.sp,\n                                color = Color(0xFF64748B),\n                                fontWeight = FontWeight.SemiBold\n                            )\n                            Text(\n                                text = lastVisitedTitle,\n                                fontSize = 13.sp,\n                                fontWeight = FontWeight.Bold,\n                                color = Color(0xFF0F172A),\n                                maxLines = 1\n                            )\n                        }\n\n                        // Round teal arrow button as seen in photo\n                        Box(\n                            modifier = Modifier\n                                .size(34.dp)\n                                .clip(CircleShape)\n                                .background(Color(0xFF0D9488)),\n                            contentAlignment = Alignment.Center\n                        ) {\n                            Icon(\n                                imageVector = Icons.AutoMirrored.Filled.ArrowForward,\n                                contentDescription = \"Lanjut\",\n                                tint = Color.White,\n                                modifier = Modifier.size(16.dp)\n                            )\n                        }\n                    }\n                }\n            }\n        }\n    }\n}\n\n@Composable\nfun SimInteractiveCard(\n    title: String,\n    subtitle: String,\n    icon: ImageVector,\n    iconColor: Color,\n    onClick: () -> Unit\n) {\n    Card(\n        modifier = Modifier\n            .width(145.dp)\n            .height(120.dp)\n            .clickable(onClick = onClick),\n        shape = RoundedCornerShape(20.dp),\n        colors = CardDefaults.cardColors(containerColor = DarkNavySlate),\n        border = androidx.compose.foundation.BorderStroke(1.dp, CardSlateBorder)\n    ) {\n        Column(\n            modifier = Modifier\n                .fillMaxSize()\n                .padding(14.dp),\n            verticalArrangement = Arrangement.SpaceBetween\n        ) {\n            Box(\n                modifier = Modifier\n                    .size(36.dp)\n                    .clip(RoundedCornerShape(10.dp))\n                    .background(DeepObsidian)\n                    .border(1.dp, CardSlateBorder, RoundedCornerShape(10.dp)),\n                contentAlignment = Alignment.Center\n            ) {\n                Icon(\n                    imageVector = icon,\n                    contentDescription = null,\n                    tint = iconColor,\n                    modifier = Modifier.size(20.dp)\n                )\n            }\n\n            Column {\n                Text(\n                    text = title,\n                    fontSize = 12.sp,\n                    fontWeight = FontWeight.Bold,\n                    color = TextPrimary,\n                    maxLines = 1\n                )\n                Text(\n                    text = subtitle,\n                    fontSize = 10.sp,\n                    color = TextSecondary,\n                    maxLines = 1\n                )\n            }\n        }\n    }\n}\n\n@Composable\nfun ModuleCard(\n    module: MriModule,\n    completedCount: Int,\n    bookmarkedCount: Int = 0,\n    onClick: () -> Unit\n) {\n    val totalNodes = module.nodes.size\n    val isComplete = completedCount == totalNodes && totalNodes > 0\n\n    Card(\n        modifier = Modifier\n            .fillMaxWidth()\n            .clickable(onClick = onClick),\n        shape = RoundedCornerShape(18.dp),\n        colors = CardDefaults.cardColors(containerColor = DarkNavySlate),\n        border = androidx.compose.foundation.BorderStroke(1.dp, CardSlateBorder)\n    ) {\n        Row(\n            modifier = Modifier\n                .fillMaxWidth()\n                .padding(16.dp),\n            horizontalArrangement = Arrangement.SpaceBetween,\n            verticalAlignment = Alignment.CenterVertically\n        ) {\n            Row(\n                modifier = Modifier.weight(1f),\n                horizontalArrangement = Arrangement.spacedBy(14.dp),\n                verticalAlignment = Alignment.CenterVertically\n            ) {\n                Box(\n                    modifier = Modifier\n                        .size(44.dp)\n                        .clip(RoundedCornerShape(12.dp))\n                        .background(if (isComplete) EmeraldDark else CyanDark)\n                        .border(1.dp, if (isComplete) EmeraldSuccess else CyanPrimary, RoundedCornerShape(12.dp)),\n                    contentAlignment = Alignment.Center\n                ) {\n                    Text(\n                        text = module.code,\n                        fontSize = 12.sp,\n                        fontWeight = FontWeight.Bold,\n                        color = if (isComplete) EmeraldSuccess else CyanBright,\n                        fontFamily = androidx.compose.ui.text.font.FontFamily.Monospace\n                    )\n                }\n\n                Column(modifier = Modifier.weight(1f)) {\n                    Row(\n                        horizontalArrangement = Arrangement.spacedBy(6.dp),\n                        verticalAlignment = Alignment.CenterVertically\n                    ) {\n                        Surface(\n                            shape = RoundedCornerShape(4.dp),\n                            color = DeepObsidian\n                        ) {\n                            Text(\n                                text = module.levelBadge,\n                                fontSize = 9.sp,\n                                fontWeight = FontWeight.Bold,\n                                color = TextMuted,\n                                modifier = Modifier.padding(horizontal = 6.dp, vertical = 2.dp)\n                            )\n                        }\n                        Text(\n                            text = \"$completedCount/$totalNodes selesai\",\n                            fontSize = 10.sp,\n                            color = if (isComplete) EmeraldSuccess else TextMuted\n                        )\n                        if (bookmarkedCount > 0) {\n                            Text(\n                                text = \"\342\200\242 \342\230\205 $bookmarkedCount\",\n                                fontSize = 10.sp,\n                                fontWeight = FontWeight.Bold,\n                                color = AmberWarning\n                            )\n                        }\n                    }\n                    Spacer(modifier = Modifier.height(2.dp))\n                    Text(\n                        text = module.title,\n                        fontSize = 14.sp,\n                        fontWeight = FontWeight.Bold,\n                        color = TextPrimary\n                    )\n                }\n            }\n\n            Icon(\n                imageVector = Icons.Default.ChevronRight,\n                contentDescription = null,\n                tint = CardSlateBorder,\n                modifier = Modifier.size(20.dp)\n            )\n        }\n    }\n}\n"
