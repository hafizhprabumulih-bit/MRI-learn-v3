        target_content: "@Composable\nfun HeroProgressCard(\n    completedCount: Int,\n    totalCount: Int,\n    lastVisitedTitle: String,\n    userAvatarId: String,\n    userName: String,\n    onOpenCharacterRoom: () -> Unit,\n    onContinueClicked: () -> Unit\n) {\n    Card(\n        modifier = Modifier.fillMaxWidth(),\n        shape = RoundedCornerShape(24.dp),\n        colors = CardDefaults.cardColors(containerColor = DarkNavySlate),\n        border = androidx.compose.foundation.BorderStroke(1.dp, CardSlateBorder),\n        elevation = CardDefaults.cardElevation(defaultElevation = 6.dp)\n    ) {\n        Box(modifier = Modifier.fillMaxSize()) {\n            // Background Image MRI Scanner Hero\n            Image(\n                painter = painterResource(id = R.drawable.mri_scanner_hero),\n                contentDescription = null,\n                modifier = Modifier.fillMaxSize(),\n                contentScale = ContentScale.Crop\n            )\n\n            // Dark gradient overlay for text readability\n            Box(\n                modifier = Modifier\n                    .fillMaxSize()\n                    .background(\n                        Brush.verticalGradient(\n                            colors = listOf(\n                                Color(0xEE090D16),\n                                Color(0xF4090D16)\n                            )\n                        )\n                    )\n            )\n\n            Column(\n                modifier = Modifier\n                    .fillMaxSize()\n                    .padding(16.dp),\n                verticalArrangement = Arrangement.spacedBy(12.dp)\n            ) {\n                // Header: Scanner Room Status & Ruang Karakter Button\n                Row(\n                    modifier = Modifier.fillMaxWidth(),\n                    horizontalArrangement = Arrangement.SpaceBetween,\n                    verticalAlignment = Alignment.CenterVertically\n                ) {\n                    Box(\n                        modifier = Modifier\n                            .background(Color(0xFF451A03), RoundedCornerShape(6.dp))\n                            .border(1.dp, AmberWarning, RoundedCornerShape(6.dp))\n                            .padding(horizontal = 6.dp, vertical = 2.dp)\n                    ) {\n                        Text(\n                            text = \"03:00 PM \342\200\242 1.5T MRI SUITE\",\n                            fontSize = 9.sp,\n                            fontWeight = FontWeight.ExtraBold,\n                            color = AmberWarning\n                        )\n                    }\n\n                    // Tombol Ruang Karakter\n                    Surface(\n                        modifier = Modifier.clickable(onClick = onOpenCharacterRoom),\n                        shape = RoundedCornerShape(12.dp),\n                        color = CyanDark,\n                        border = androidx.compose.foundation.BorderStroke(1.dp, CyanBright)\n                    ) {\n                        Row(\n                            modifier = Modifier.padding(horizontal = 10.dp, vertical = 5.dp),\n                            verticalAlignment = Alignment.CenterVertically,\n                            horizontalArrangement = Arrangement.spacedBy(4.dp)\n                        ) {\n                            Icon(imageVector = Icons.Default.Face, contentDescription = \"Ruang Karakter\", tint = CyanBright, modifier = Modifier.size(14.dp))\n                            Text(\n                                text = \"Ruang Karakter\",\n                                fontSize = 10.sp,\n                                fontWeight = FontWeight.Bold,\n                                color = CyanBright\n                            )\n                        }\n                    }\n                }\n\n                // Scene Ruang Kontrol: Avatar & 3 Monitor Progres Pemindaian\n                Row(\n                    modifier = Modifier.fillMaxWidth(),\n                    horizontalArrangement = Arrangement.spacedBy(12.dp),\n                    verticalAlignment = Alignment.CenterVertically\n                ) {\n                    // Avatar Box di Scene\n                    Box(\n                        modifier = Modifier\n                            .size(64.dp)\n                            .clip(CircleShape)\n                            .background(CardSlate)\n                            .border(2.dp, CyanBright, CircleShape)\n                            .clickable(onClick = onOpenCharacterRoom),\n                        contentAlignment = Alignment.Center\n                    ) {\n                        Image(\n                            painter = painterResource(id = MriRepository.getAvatarDrawableRes(userAvatarId)),\n                            contentDescription = \"Avatar Pengguna\",\n                            modifier = Modifier.fillMaxSize(),\n                            contentScale = ContentScale.Crop\n                        )\n                    }\n\n                    // 3 Monitor \"Progres Pemindaian\"\n                    Column(\n                        modifier = Modifier.weight(1f),\n                        verticalArrangement = Arrangement.spacedBy(6.dp)\n                    ) {\n                        ScanProgressBar(\n                            label = \"Modul Kurikulum (${completedCount}/${totalCount})\",\n                            progress = if (totalCount > 0) completedCount.toFloat() / totalCount.toFloat() else 0f\n                        )\n                        ScanProgressBar(\n                            label = \"Uji Kompetensi Kuis\",\n                            progress = if (completedCount > 0) 0.65f else 0.15f\n                        )\n                        ScanProgressBar(\n                            label = \"Simulasi & Glosarium\",\n                            progress = if (completedCount > 0) 0.8f else 0.2f\n                        )\n                    }\n                }\n\n                // \"Lanjutkan\" Pill Button\n                Surface(\n                    modifier = Modifier\n                        .fillMaxWidth()\n                        .clickable(onClick = onContinueClicked),\n                    shape = RoundedCornerShape(16.dp),\n                    color = Color(0xF2F8FAFC)\n                ) {\n                    Row(\n                        modifier = Modifier\n                            .fillMaxWidth()\n                            .padding(horizontal = 14.dp, vertical = 9.dp),\n                        horizontalArrangement = Arrangement.SpaceBetween,\n                        verticalAlignment = Alignment.CenterVertically\n                    ) {\n                        Column {\n                            Text(\n                                text = \"Lanjutkan Belajar\",\n                                fontSize = 10.sp,\n                                color = Color(0xFF64748B),\n                                fontWeight = FontWeight.SemiBold\n                            )\n                            Text(\n                                text = lastVisitedTitle,\n                                fontSize = 13.sp,\n                                fontWeight = FontWeight.Bold,\n                                color = Color(0xFF0F172A),\n                                maxLines = 1\n                            )\n                        }\n\n                        Box(\n                            modifier = Modifier\n                                .size(34.dp)\n                                .clip(CircleShape)\n                                .background(Color(0xFF0D9488)),\n                            contentAlignment = Alignment.Center\n                        ) {\n                            Icon(\n                                imageVector = Icons.AutoMirrored.Filled.ArrowForward,\n                                contentDescription = \"Lanjut\",\n                                tint = Color.White,\n                                modifier = Modifier.size(16.dp)\n                            )\n                        }\n                    }\n                }\n            }\n        }\n    }\n}\n\n@Composable\nfun ScanProgressBar(label: String, progress: Float) {\n    Column(modifier = Modifier.fillMaxWidth()) {\n        Row(\n            modifier = Modifier.fillMaxWidth(),\n            horizontalArrangement = Arrangement.SpaceBetween\n        ) {\n            Text(text = label, fontSize = 9.sp, fontWeight = FontWeight.Bold, color = TextSecondary)\n            Text(text = \"${(progress * 100).toInt()}%\", fontSize = 9.sp, fontWeight = FontWeight.Bold, color = CyanBright)\n        }\n        Spacer(modifier = Modifier.height(2.dp))\n        LinearProgressIndicator(\n            progress = { progress.coerceIn(0f, 1f) },\n            modifier = Modifier\n                .fillMaxWidth()\n                .height(4.dp)\n                .clip(RoundedCornerShape(2.dp)),\n            color = if (progress > 0.3f) CyanBright else Color(0xFF475569),\n            trackColor = CardSlate\n        )\n    }\n}"
        replacement_content: "@Composable\nfun HeroProgressCard(\n    completedCount: Int,\n    totalCount: Int,\n    lastVisitedTitle: String,\n    onContinueClicked: () -> Unit\n) {\n    Card(\n        modifier = Modifier\n            .fillMaxWidth()\n            .height(190.dp),\n        shape = RoundedCornerShape(24.dp),\n        colors = CardDefaults.cardColors(containerColor = DarkNavySlate),\n        elevation = CardDefaults.cardElevation(defaultElevation = 6.dp)\n    ) {\n        Box(modifier = Modifier.fillMaxSize()) {\n            // Background Image MRI Scanner Hero\n            Image(\n                painter = painterResource(id = R.drawable.mri_scanner_hero),\n                contentDescription = null,\n                modifier = Modifier.fillMaxSize(),\n                contentScale = ContentScale.Crop\n            )\n\n            // Dark gradient overlay for text readability\n            Box(\n                modifier = Modifier\n                    .fillMaxSize()\n                    .background(\n                        Brush.verticalGradient(\n                            colors = listOf(\n                                Color(0xCC090D16),\n                                Color(0xF0090D16)\n                            )\n                        )\n                    )\n            )\n\n            // Content inside hero\n            Column(\n                modifier = Modifier\n                    .fillMaxSize()\n                    .padding(18.dp),\n                verticalArrangement = Arrangement.SpaceBetween\n            ) {\n                Column {\n                    Text(\n                        text = \"PROGRES KURIKULUM KLINIS\",\n                        fontSize = 10.sp,\n                        fontWeight = FontWeight.ExtraBold,\n                        color = AmberWarning,\n                        letterSpacing = 1.2.sp\n                    )\n                    Spacer(modifier = Modifier.height(4.dp))\n                    Text(\n                        text = \"$completedCount dari $totalCount simpul kompetensi\",\n                        fontSize = 18.sp,\n                        fontWeight = FontWeight.Bold,\n                        color = TextPrimary\n                    )\n\n                    Spacer(modifier = Modifier.height(10.dp))\n\n                    // Progress Bar\n                    val progress = if (totalCount > 0) completedCount.toFloat() / totalCount.toFloat() else 0f\n                    LinearProgressIndicator(\n                        progress = { progress },\n                        modifier = Modifier\n                            .fillMaxWidth()\n                            .height(6.dp)\n                            .clip(RoundedCornerShape(3.dp)),\n                        color = CyanBright,\n                        trackColor = CardSlate\n                    )\n                }\n\n                // \"Lanjutkan\" Pill Button matching photo!\n                Surface(\n                    modifier = Modifier\n                        .fillMaxWidth()\n                        .clickable(onClick = onContinueClicked),\n                    shape = RoundedCornerShape(16.dp),\n                    color = Color(0xF2F8FAFC)\n                ) {\n                    Row(\n                        modifier = Modifier\n                            .fillMaxWidth()\n                            .padding(horizontal = 14.dp, vertical = 9.dp),\n                        horizontalArrangement = Arrangement.SpaceBetween,\n                        verticalAlignment = Alignment.CenterVertically\n                    ) {\n                        Column {\n                            Text(\n                                text = \"Lanjutkan\",\n                                fontSize = 10.sp,\n                                color = Color(0xFF64748B),\n                                fontWeight = FontWeight.SemiBold\n                            )\n                            Text(\n                                text = lastVisitedTitle,\n                                fontSize = 13.sp,\n                                fontWeight = FontWeight.Bold,\n                                color = Color(0xFF0F172A),\n                                maxLines = 1\n                            )\n                        }\n\n                        Box(\n                            modifier = Modifier\n                                .size(34.dp)\n                                .clip(CircleShape)\n                                .background(Color(0xFF0D9488)),\n                            contentAlignment = Alignment.Center\n                        ) {\n                            Icon(\n                                imageVector = Icons.AutoMirrored.Filled.ArrowForward,\n                                contentDescription = \"Lanjut\",\n                                tint = Color.White,\n                                modifier = Modifier.size(16.dp)\n                            )\n                        }\n                    }\n                }\n            }\n        }\n    }\n}"
